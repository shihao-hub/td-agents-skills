#!/usr/bin/env python3
"""pre-commit hook: scan staged diff for domestic secrets."""
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from secret_scanner import scan_text


def main() -> int:
    try:
        diff = subprocess.run(
            ["git", "diff", "--cached", "--", ":/", ":!.gitleaks.toml", ":!.tests/*"],
            capture_output=True, text=True, encoding="utf-8", errors="ignore",
        ).stdout
    except Exception as e:
        print(f"secret-scan: 无法读取暂存区 ({e})，跳过。")
        return 0
    if not diff.strip():
        return 0
    findings = scan_text(diff)
    if findings:
        print("⛔ [secret-scan] 检测到疑似国内平台敏感凭据，提交已拦截：")
        for f in findings:
            print(f"  - [{f['rule']}] line {f['line']}: {f['match']}")
        print("\n确认无误请用 `git commit --no-verify` 跳过（不推荐）。")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
